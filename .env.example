NODE_ENV=production
HOST=0.0.0.0
PORT=8050

# Nuxt Auth
AUTH_SECRET="chaoxing-sign"
AUTH_ORIGIN="http://localhost:8050"
NEXTAUTH_URL="http://localhost:8050"

# Prisma
DATABASE_URL="postgresql://username:password@localhost:5432/chaoxing"

# APP
NUXT_IM_INIT_CONNECT=false # 启动时是否自动重连
# 重新扫描时是否自动选中上一轮失败账号
NUXT_PUBLIC_QR_CODE_AUTO_SELECT_FAILED_ON_RETRY=true
# 网页账户注册：改成 true 并重启后开放 5 分钟，到期自动写回 false
ALLOW_WEB_REGISTRATION=false
# 学习通 HTTP/HTTPS 代理；留空直连，修改后重启生效
# 示例：http://127.0.0.1:7890 或 http://user:password@proxy.example:8080
CX_PROXY_URL=

# 百度地图开放平台 Web 服务应用 AK，仅在服务端使用；用于扫码位置签到逆地理编码
# 应用需开通全球逆地理编码服务，并允许服务端 IP 访问
BAIDU_MAP_SERVER_AK=
